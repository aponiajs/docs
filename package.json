{
  "name": "docs",
  "version": "0.0.8",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "wrangler pages dev out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint",
    "seo:check": "bun scripts/check-seo.mjs",
    "preview": "bun run build && bun run start",
    "deploy": "bun scripts/require-site-url.mjs && bun run build && bun run seo:check && wrangler pages deploy out --project-name=docs"
  },
  "dependencies": {
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.12.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.74.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
